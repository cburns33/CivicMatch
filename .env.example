# The public fixture explorer needs no database. /admin uses a confirmed project.
# Public project URL and publishable key only. Never expose a service role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional operator-only environment for scripts/import-review.mjs --hosted.
# Never use NEXT_PUBLIC_ for reviewer credentials or commit their values.
CIVICMATCH_REVIEWER_EMAIL=
CIVICMATCH_REVIEWER_PASSWORD=
